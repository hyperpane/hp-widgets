{
  "manifest": 1,
  "id": "widgets",
  "name": "Widgets",
  "version": "0.0.1",
  "publisher": "hyperpane",
  "description": "Make your own tool panels: lay out buttons, fields, switches and logs on a grid, then give them JavaScript and shell commands that run on the server. Export and import them as .hpw files.",
  "icon": "icon.svg",
  "category": "DevOps",
  "homepage": "https://github.com/hyperpane/hp-widgets",
  "license": "MIT",
  "engines": {
    "hyperpane": ">=0.2.2",
    "node": ">=22.15.0"
  },
  "client": {
    "main": "main.tsx"
  },
  "server": {
    "runtime": "node",
    "main": "main.ts"
  },
  "contributes": {
    "nodes": [
      {
        "kind": "panel",
        "title": "Widgets",
        "icon": "icon.svg",
        "size": [
          900,
          600
        ],
        "ports": [
          { "id": "values", "label": "Values", "direction": "out", "type": "json" }
        ]
      }
    ]
  },
